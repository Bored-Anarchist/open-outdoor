{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.invalid/schemas/phase3-guided-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "generatedAt",
    "startedAt",
    "completedAt",
    "sourceCommit",
    "workingTreeClean",
    "nodeVersion",
    "platform",
    "status",
    "physicalReport",
    "commands",
    "passedTestFiles",
    "physicalEvaluation",
    "enduranceDisposition",
    "acceptance",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "const": "iphone14-ios26.6-phase3-v1" },
    "generatedAt": { "$ref": "#/$defs/instant" },
    "startedAt": { "$ref": "#/$defs/instant" },
    "completedAt": { "$ref": "#/$defs/instant" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "workingTreeClean": { "type": "boolean" },
    "nodeVersion": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "blocked"] },
    "physicalReport": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/command" }
    },
    "passedTestFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "physicalEvaluation": { "$ref": "#/$defs/evaluation" },
    "enduranceDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockingPhase", "workPackage", "findings"],
      "properties": {
        "status": { "enum": ["passed", "conditionally-approved"] },
        "blockingPhase": { "const": "Phase 5" },
        "workPackage": { "const": "WP-503" },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionArtifacts",
        "catalogSafety",
        "offlineProduct",
        "privateComposition",
        "backupRestore",
        "fieldReadiness",
        "accessibility",
        "installableIos",
        "privacyRights"
      ],
      "properties": {
        "productionArtifacts": { "$ref": "#/$defs/criterion" },
        "catalogSafety": { "$ref": "#/$defs/criterion" },
        "offlineProduct": { "$ref": "#/$defs/criterion" },
        "privateComposition": { "$ref": "#/$defs/criterion" },
        "backupRestore": { "$ref": "#/$defs/criterion" },
        "fieldReadiness": { "$ref": "#/$defs/criterion" },
        "accessibility": { "$ref": "#/$defs/criterion" },
        "installableIos": { "$ref": "#/$defs/criterion" },
        "privacyRights": { "$ref": "#/$defs/criterion" }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "passed",
        "exitCode",
        "durationMilliseconds",
        "outputSha256",
        "failureExcerpt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "failureExcerpt": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockers"],
      "properties": {
        "status": { "enum": ["passed", "blocked"] },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "evidence"],
      "properties": {
        "passed": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
