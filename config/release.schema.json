{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.invalid/schemas/release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tools", "gis", "ios", "channels", "regions", "schemas", "budgets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "python", "uv", "expo"],
      "properties": {
        "node": { "const": "24.19.0" },
        "pnpm": { "const": "11.20.0" },
        "python": { "const": "3.13.14" },
        "uv": { "const": "0.12.1" },
        "expo": { "const": "56.0.20" }
      }
    },
    "gis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gdal", "postgis", "sqlite"],
      "properties": {
        "gdal": { "const": "3.13.0" },
        "postgis": { "const": "3.6.4" },
        "sqlite": { "const": "3.53.4" }
      }
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentTarget", "runner", "xcode"],
      "properties": {
        "deploymentTarget": { "const": "16.4" },
        "runner": { "const": "macos-26" },
        "xcode": { "const": "26.4.1" }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "local", "private"],
      "properties": {
        "public": { "$ref": "#/$defs/channel" },
        "local": { "$ref": "#/$defs/channel" },
        "private": { "$ref": "#/$defs/channel" }
      }
    },
    "regions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "backup"],
      "properties": {
        "catalog": { "type": "integer", "minimum": 1 },
        "backup": { "type": "integer", "minimum": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosticRetentionHours", "publicArtifactRetentionDays", "ciMaximumMinutes"],
      "properties": {
        "diagnosticRetentionHours": { "const": 24 },
        "publicArtifactRetentionDays": { "const": 1 },
        "ciMaximumMinutes": { "const": 30 }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appName", "bundleIdentifier", "trustRoot"],
      "properties": {
        "appName": { "type": "string", "minLength": 1 },
        "bundleIdentifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]+$" },
        "trustRoot": { "type": "string", "minLength": 1 }
      }
    }
  }
}
