{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.invalid/schemas/release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tools",
    "gis",
    "ios",
    "channels",
    "regions",
    "schemas",
    "phase0",
    "phase3",
    "budgets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "python", "uv", "expo"],
      "properties": {
        "node": { "const": "24.19.0" },
        "pnpm": { "const": "11.20.0" },
        "python": { "const": "3.13.14" },
        "uv": { "const": "0.12.1" },
        "expo": { "const": "56.0.20" }
      }
    },
    "gis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gdal", "postgis", "sqlite"],
      "properties": {
        "gdal": { "const": "3.13.0" },
        "postgis": { "const": "3.6.4" },
        "sqlite": { "const": "3.53.4" }
      }
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentTarget", "runner", "xcode"],
      "properties": {
        "deploymentTarget": { "const": "16.4" },
        "runner": { "const": "macos-26" },
        "xcode": { "const": "26.4.1" }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "local", "private"],
      "properties": {
        "public": { "$ref": "#/$defs/channel" },
        "local": { "$ref": "#/$defs/channel" },
        "private": { "$ref": "#/$defs/channel" }
      }
    },
    "regions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "backup"],
      "properties": {
        "catalog": { "type": "integer", "minimum": 1 },
        "backup": { "type": "integer", "minimum": 1 }
      }
    },
    "phase0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "referenceDevice", "tracker", "catalog"],
      "properties": {
        "profileId": { "const": "iphone14-ios26.6-phase0-v1" },
        "referenceDevice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "os"],
          "properties": {
            "model": { "const": "iPhone 14" },
            "os": { "const": "iOS 26.6" }
          }
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "batchMaximumSeconds",
            "recordingControlP95Ms",
            "maximumCommittedDataGapSeconds",
            "maximumCommittedDataGapBatches",
            "screenOffResidentMemoryP95MiB",
            "energyPolicy"
          ],
          "properties": {
            "batchMaximumSeconds": { "const": 30 },
            "recordingControlP95Ms": { "const": 500 },
            "maximumCommittedDataGapSeconds": { "const": 30 },
            "maximumCommittedDataGapBatches": { "const": 1 },
            "screenOffResidentMemoryP95MiB": { "const": 150 },
            "energyPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "acceptancePhase",
                "deferredWorkPackages",
                "sensorsOnlyDuringActiveRecording",
                "continuousPollingAllowed",
                "highAccuracyRequiresExplicitSelection",
                "balancedDistanceFilterMeters",
                "enduranceDistanceFilterMeters"
              ],
              "properties": {
                "acceptancePhase": { "const": "deferred-field-hardening" },
                "deferredWorkPackages": {
                  "type": "array",
                  "prefixItems": [{ "const": "WP-307" }, { "const": "WP-503" }],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "sensorsOnlyDuringActiveRecording": { "const": true },
                "continuousPollingAllowed": { "const": false },
                "highAccuracyRequiresExplicitSelection": { "const": true },
                "balancedDistanceFilterMeters": { "const": 10 },
                "enduranceDistanceFilterMeters": { "const": 25 }
              }
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "combinedInstalledMaximumBytes",
            "minimumWorkspaceBytes",
            "postActivationReserveBytes"
          ],
          "properties": {
            "combinedInstalledMaximumBytes": { "const": 3221225472 },
            "minimumWorkspaceBytes": { "const": 1073741824 },
            "postActivationReserveBytes": { "const": 2147483648 }
          }
        }
      }
    },
    "phase3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldProfileId",
        "referenceDevice",
        "requiredRunsPerMode",
        "requiredModes",
        "minimumDurationMinutes",
        "maximumBatteryPercentPerHour",
        "maximumSeriousThermalSeconds",
        "maximumCriticalThermalSeconds",
        "maximumCheckpointGapSeconds",
        "maximumStorageGrowthMiBPerHour"
      ],
      "properties": {
        "fieldProfileId": { "const": "iphone14-ios26.6-phase3-v1" },
        "referenceDevice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "os"],
          "properties": {
            "model": { "const": "iPhone 14" },
            "os": { "const": "iOS 26.6" }
          }
        },
        "requiredRunsPerMode": { "const": 3 },
        "requiredModes": {
          "type": "array",
          "prefixItems": [{ "const": "balanced" }, { "const": "endurance" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "minimumDurationMinutes": { "const": 180 },
        "maximumBatteryPercentPerHour": {
          "type": "object",
          "additionalProperties": false,
          "required": ["balanced", "endurance"],
          "properties": {
            "balanced": { "const": 6 },
            "endurance": { "const": 4 }
          }
        },
        "maximumSeriousThermalSeconds": { "const": 0 },
        "maximumCriticalThermalSeconds": { "const": 0 },
        "maximumCheckpointGapSeconds": { "const": 30 },
        "maximumStorageGrowthMiBPerHour": { "const": 64 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosticRetentionHours", "publicArtifactRetentionDays", "ciMaximumMinutes"],
      "properties": {
        "diagnosticRetentionHours": { "const": 24 },
        "publicArtifactRetentionDays": { "const": 1 },
        "ciMaximumMinutes": { "const": 30 }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appName", "bundleIdentifier", "trustRoot"],
      "properties": {
        "appName": { "type": "string", "minLength": 1 },
        "bundleIdentifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]+$" },
        "trustRoot": { "type": "string", "minLength": 1 }
      }
    }
  }
}
