{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.invalid/schemas/hosted-ci-window.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "startsAfter", "requiredApplicableRuns", "assessments"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "startsAfter": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "requiredApplicableRuns": { "const": 20 },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "workflow", "createdAt", "classification", "reason"],
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "workflow": { "type": "string", "minLength": 1 },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "classification": {
            "enum": ["applicable-clean", "avoidable-failure", "excluded"]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
