{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "rights", "planned"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "role", "url", "status", "evidence"],
        "properties": {
          "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "role": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
          "status": {
            "enum": [
              "Supported",
              "Conditional",
              "Unconfirmed",
              "Permission required",
              "Restricted",
              "Lead only"
            ]
          },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "planned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "role", "name", "url", "notes", "review"],
        "properties": {
          "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "role": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
          "notes": { "type": "string" },
          "review": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
