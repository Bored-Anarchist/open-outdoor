    "defects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{1,40}$"
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "status": {
            "enum": ["open", "resolved"]
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "reviewer", "evidenceSha256"],
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string",
          "maxLength": 39
        },
        "evidenceSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
