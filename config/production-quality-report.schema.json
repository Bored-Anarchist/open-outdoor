{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "sourceCommit",
    "binarySha256",
    "environment",
    "deviceModel",
    "systemVersion",
    "coordinateFree",
    "containsPersonalData",
    "accessibility",
    "performance",
    "fieldRuns",
    "defects",
    "attestation"
