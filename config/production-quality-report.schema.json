  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "binarySha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "enum": ["physical-iphone", "simulator", "browser"]
    },
    "deviceModel": {
      "type": "string",
      "maxLength": 30
    },
    "systemVersion": {
      "type": "string",
      "maxLength": 30
    },
    "coordinateFree": {
      "const": true
    },
    "containsPersonalData": {
      "const": false
    },
    "accessibility": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
