    "fieldRuns": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "sourceCommit",
          "binarySha256",
          "evidenceSha256",
          "mode",
          "startedAt",
          "endedAt",
          "durationMinutes",
          "batteryStartPercent",
          "batteryEndPercent",
          "chargingDuringRun",
          "seriousThermalSeconds",
          "criticalThermalSeconds",
          "maximumCheckpointGapSeconds",
          "storageGrowthBytes",
          "sensorsActiveWhileStoppedSeconds",
          "offlineBrowsePassed",
          "offlineSearchPassed",
          "crashRecoveryPassed",
          "degradedGpsStatePassed",
          "accessibilityPassed"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "binarySha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "enum": ["balanced", "endurance"]
          },
          "startedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
          },
          "endedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
          },
          "durationMinutes": {
            "type": "number",
            "minimum": 180,
            "maximum": 1440
          },
          "batteryStartPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "batteryEndPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "chargingDuringRun": {
            "type": "boolean"
          },
          "seriousThermalSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "criticalThermalSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maximumCheckpointGapSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "storageGrowthBytes": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sensorsActiveWhileStoppedSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "offlineBrowsePassed": {
            "type": "boolean"
          },
          "offlineSearchPassed": {
            "type": "boolean"
          },
          "crashRecoveryPassed": {
            "type": "boolean"
          },
          "degradedGpsStatePassed": {
            "type": "boolean"
          },
          "accessibilityPassed": {
            "type": "boolean"
          }
        }
      }
