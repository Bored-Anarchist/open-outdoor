{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.invalid/schemas/phase2-guided-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "generatedAt",
    "startedAt",
    "completedAt",
    "sourceCommit",
    "workingTreeClean",
    "nodeVersion",
    "platform",
    "mode",
    "status",
    "requiredSourceIds",
    "observedCaseIds",
    "passedTestFiles",
    "commands",
    "sourceProbes",
    "acceptance",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "const": "new-york-data-alpha-phase2-v1" },
    "generatedAt": { "$ref": "#/$defs/instant" },
    "startedAt": { "$ref": "#/$defs/instant" },
    "completedAt": { "$ref": "#/$defs/instant" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "workingTreeClean": { "type": "boolean" },
    "nodeVersion": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["live", "offline"] },
    "status": { "enum": ["passed", "blocked"] },
    "requiredSourceIds": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observedCaseIds": {
      "type": "array",
      "minItems": 18,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^T-[A-Z]+-[0-9]+-C[0-9]+$" }
    },
    "passedTestFiles": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/command" }
    },
    "sourceProbes": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/probe" }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalContracts",
        "campingSafety",
        "connectorContracts",
        "entityResolution",
        "hostileIngestion",
        "liveSourceAvailability",
        "publicPackReproducibility",
        "publicationBoundary",
        "rightsAndAttribution",
        "coverageAndExclusions"
      ],
      "properties": {
        "canonicalContracts": { "$ref": "#/$defs/criterion" },
        "campingSafety": { "$ref": "#/$defs/criterion" },
        "connectorContracts": { "$ref": "#/$defs/criterion" },
        "entityResolution": { "$ref": "#/$defs/criterion" },
        "hostileIngestion": { "$ref": "#/$defs/criterion" },
        "liveSourceAvailability": { "$ref": "#/$defs/criterion" },
        "publicPackReproducibility": { "$ref": "#/$defs/criterion" },
        "publicationBoundary": { "$ref": "#/$defs/criterion" },
        "rightsAndAttribution": { "$ref": "#/$defs/criterion" },
        "coverageAndExclusions": { "$ref": "#/$defs/criterion" }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "passed",
        "exitCode",
        "durationMilliseconds",
        "outputSha256",
        "failureExcerpt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "failureExcerpt": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "family",
        "hostname",
        "passed",
        "statusCode",
        "contentType",
        "sampledBytes",
        "durationMilliseconds",
        "observation"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "statusCode": {
          "anyOf": [{ "type": "integer", "minimum": 100, "maximum": 599 }, { "type": "null" }]
        },
        "contentType": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "sampledBytes": { "type": "integer", "minimum": 0 },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "evidence"],
      "properties": {
        "passed": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
