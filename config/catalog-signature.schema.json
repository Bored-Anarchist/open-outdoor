{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.invalid/schemas/catalog-signature.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "channel",
    "trustRoot",
    "keyId",
    "antiReplayVersion",
    "manifestSha256",
    "signedAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "channel": { "enum": ["public", "local", "private"] },
    "trustRoot": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "antiReplayVersion": { "type": "integer", "minimum": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signedAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
  }
}
