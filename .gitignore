# Local secrets and private extensions must never enter the public checkout.
/PrivateData/
/apps/mobile/.private-map-data/
.env
.env.*
!.env.example
.private/
private/
secrets/
credentials/
*.key
*.pem
*.p12
*.mobileprovision

# Generated output and dependency caches.
node_modules/
.pnpm-store/
.venv/
.expo/
build/
dist/
coverage/
*.log
*.tsbuildinfo
__pycache__/
*.py[cod]
.tmp-*

# Full state datasets are generated locally or restored from external artifact storage.
# Keep only manifests, checksums, notices and inventories in Git.
/packages/map/src/assets/state-packages/US/*/outdoors.geojson
/packages/map/src/assets/state-packages/US/*/index.json
/packages/map/src/assets/state-packages/US/*/state.sqlite
/packages/map/src/assets/state-packages/US/*/parts/

# Local editor and operating-system metadata.
.idea/
.vscode/
.DS_Store
Thumbs.db
