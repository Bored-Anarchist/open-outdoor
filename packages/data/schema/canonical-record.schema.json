{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.example/schema/canonical-record-1.0.0.json",
  "title": "Open Outdoor canonical record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "id",
    "source",
    "retrievedAt",
    "sourceUpdatedAt",
    "geometry",
    "geometryQuality",
    "fieldProvenance",
    "rights",
    "validation",
    "contentChecksum",
    "tombstone",
    "classification",
    "properties"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "recordType": {
      "enum": [
        "land-unit",
        "place",
        "trail",
        "condition",
        "restriction",
        "observation",
        "review",
        "check-in",
        "media-asset"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "externalId",
        "sourcePartition",
        "connectorVersion",
        "parserVersion",
        "normalizerVersion"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string", "minLength": 1 },
        "sourcePartition": { "type": "string", "minLength": 1 },
        "connectorVersion": { "type": "string", "minLength": 1 },
        "parserVersion": { "type": "string", "minLength": 1 },
        "normalizerVersion": { "type": "string", "minLength": 1 }
      }
    },
    "retrievedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "sourceUpdatedAt": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time", "pattern": "Z$" }]
    },
    "geometry": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "enum": ["Point", "LineString", "MultiLineString", "Polygon", "MultiPolygon"]
            },
            "coordinates": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "geometryQuality": { "type": ["object", "null"] },
    "fieldProvenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sourceField", "sourceValue", "observedAt", "transformation"]
      }
    },
    "rights": {
      "type": "object",
      "required": ["policyId", "distribution", "attribution"]
    },
    "validation": {
      "type": "object",
      "required": ["state", "reasonCodes"]
    },
    "contentChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tombstone": { "type": "boolean" },
    "classification": {
      "enum": ["public-reference", "private-reference", "private-user"]
    },
    "properties": { "type": "object" }
  }
}
