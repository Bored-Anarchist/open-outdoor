{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-outdoor.example/schema/connector-manifest-1.0.0.json",
  "title": "Open Outdoor connector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connectorVersion",
    "sourceId",
    "lifecycle",
    "authorization",
    "acquisitionMode",
    "sourceClass",
    "classification",
    "allowedTransports",
    "allowedHosts",
    "secretNames",
    "rights",
    "limits",
    "requiredFreshnessSeconds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "connectorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lifecycle": {
      "enum": ["experimental", "active", "failing", "disabled", "retired"]
    },
    "authorization": {
      "enum": ["authorized", "permission-required", "expired", "revoked"]
    },
    "acquisitionMode": {
      "enum": ["automated", "manual-import", "user-export", "overlay", "deep-link-only"]
    },
    "sourceClass": { "enum": ["current", "legacy"] },
    "classification": {
      "enum": [
        "PUBLIC_SYNTHETIC",
        "SOURCE_REDISTRIBUTABLE",
        "PRIVATE_USER",
        "PRIVATE_ORGANIZATION",
        "SOURCE_RESTRICTED"
      ]
    },
    "allowedTransports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["https", "file"] }
    },
    "allowedHosts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "secretNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawRetention",
        "parsedFields",
        "media",
        "derivedData",
        "offlineStorage",
        "distribution",
        "attribution",
        "termsUrl",
        "evidenceReviewedAt",
        "reviewExpiresAt"
      ],
      "properties": {
        "rawRetention": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^P(?:[0-9]+D|T[0-9]+H)$" }]
        },
        "parsedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "media": { "type": "boolean" },
        "derivedData": { "type": "boolean" },
        "offlineStorage": { "type": "boolean" },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["public", "private-user", "private-organization"],
          "properties": {
            "public": { "type": "boolean" },
            "private-user": { "type": "boolean" },
            "private-organization": { "type": "boolean" }
          }
        },
        "attribution": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "termsUrl": { "type": "string", "pattern": "^https://" },
        "evidenceReviewedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "reviewExpiresAt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time", "pattern": "Z$" }
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPayloadBytes",
        "maxArchiveEntries",
        "maxExpandedBytes",
        "maxCompressionRatio",
        "maxParserMilliseconds",
        "maxRedirects",
        "maxConcurrency"
      ],
      "properties": {
        "maxPayloadBytes": { "type": "integer", "minimum": 1 },
        "maxArchiveEntries": { "type": "integer", "minimum": 1 },
        "maxExpandedBytes": { "type": "integer", "minimum": 1 },
        "maxCompressionRatio": { "type": "integer", "minimum": 1 },
        "maxParserMilliseconds": { "type": "integer", "minimum": 1 },
        "maxRedirects": { "type": "integer", "minimum": 0 },
        "maxConcurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "requiredFreshnessSeconds": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
    }
  }
}
