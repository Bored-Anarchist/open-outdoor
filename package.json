{
  "name": "open-outdoor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "source": "node tools/catalog/source.mjs",
    "private:compatibility": "node tools/catalog/private-compatibility.mjs",
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Bootstrap.ps1",
    "quality": "pnpm map:storage:verify && pnpm quality:types && pnpm docs:check && pnpm quality:format && pnpm release:verify && pnpm test && pnpm test:release && pnpm test:dependencies",
    "quality:types": "node tools/quality/repository-checks.mjs types",
    "quality:format": "prettier --check .",
    "test": "vitest run",
    "test:dependencies": "node --test tools/test/dependency-compatibility.test.mjs",
    "test:fixtures": "vitest run packages/data",
    "test:privacy": "vitest run packages/privacy && node tools/quality/public-boundary.mjs --scan .",
    "test:catalog-trust": "vitest run packages/config/test/catalog-trust.test.ts",
    "test:tracking": "vitest run packages/tracking",
    "test:storage": "vitest run packages/storage",
    "test:phase1": "vitest run packages/shared packages/map packages/storage packages/tracking packages/import-export packages/backup packages/recorder",
    "test:private-root": "vitest run packages/privacy/test/private-root.test.ts",
    "test:private-downstream": "node tools/quality/private-ci-policy.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-PrivateDownstream.ps1",
    "build:web": "pnpm --filter @open-outdoor/browser-fixture build",
    "build:ios:bundle": "pnpm --filter @open-outdoor/mobile exec expo export --platform ios --output-dir ../../dist/ios-export --clear",
    "build:ios:unsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-IosUnsigned.ps1",
    "build:ios:unsigned:private": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-IosPrivateUnsigned.ps1",
    "catalog:public": "node tools/catalog/public-catalog.mjs",
    "catalog:private": "node tools/catalog/private-catalog.mjs",
    "catalog:private:ioverlander": "pnpm exec tsc -b packages/shared packages/data && node tools/catalog/ioverlander-private-catalog.mjs",
    "phase0:gate": "node tools/acceptance/phase0-gate.mjs",
    "phase1:gate": "node tools/acceptance/phase1-gate.mjs",
    "phase1:evidence": "node tools/acceptance/phase1-evidence.mjs",
    "phase2:gate": "node tools/acceptance/phase2-gate.mjs",
    "test:phase2": "vitest run packages/data tools/test/phase2-guided.test.ts tools/test/phase2-gate.test.ts",
    "test:phase3": "vitest run packages/data/test/public-pack.test.ts packages/data/test/production-pack.test.ts packages/map packages/storage/test/catalog-activation.test.ts packages/storage/test/composition.test.ts packages/backup/test/backup.test.ts packages/tracking/test/field-hardening.test.ts tools/test/phase3-guided.test.ts",
    "ci:window": "node tools/acceptance/hosted-ci-window.mjs",
    "release:verify": "node tools/quality/validate-release-config.mjs && node tools/quality/validate-workflows.mjs && node tools/quality/validate-native-spikes.mjs",
    "python:test": "uv run --frozen --group loader python -m unittest discover -s python/tests",
    "test:design:browser": "node tools/quality/design-browser-qa.mjs",
    "phase5:quality": "node tools/quality/production-quality.mjs",
    "profile:desktop": "node tools/quality/production-benchmark.mjs",
    "test:release": "node tools/quality/repository-checks.mjs release-tests",
    "agency:feeds": "node tools/acquisition/state-agency-feeds.mjs",
    "release:artifacts": "node tools/quality/release-artifacts.mjs",
    "release:sbom": "node tools/quality/release-sbom.mjs",
    "phase5:audit": "node tools/quality/release-audit.mjs",
    "map:acquire": "node --use-system-ca tools/acquisition/acquire-outdoor-map.mjs",
    "map:public:compose": "pnpm exec tsc -b packages/shared packages/data && node tools/packages/compose-official-public-map.mjs",
    "map:acquire-style": "node --use-system-ca tools/acquisition/acquire-basemap-style.mjs",
    "nps:acquire:ny": "node --use-system-ca tools/acquisition/acquire-nps-new-york.mjs",
    "federal:acquire:ny": "node --use-system-ca tools/acquisition/acquire-federal-new-york.mjs",
    "map:private:stage": "node tools/packages/stage-private-mobile-map.mjs --input \"PrivateData/catalogs/US/New York/current\"",
    "test:map:browser": "node tools/quality/outdoor-map-qa.mjs",
    "test:map:offline": "node tools/quality/offline-map-qa.mjs",
    "map:acquire:hikes": "node --use-system-ca tools/acquisition/acquire-hike-profiles.mjs",
    "map:public:agency": "node tools/acquisition/acquire-public-state-agency.mjs",
    "map:acquire:states": "pnpm exec tsc -b packages/shared && node --use-system-ca tools/acquisition/acquire-state-packages.mjs",
    "map:public:package": "pnpm exec tsc -b packages/shared && pnpm exec vite build --config tools/packages/public-state-parser.config.ts && node tools/packages/build-public-state-packages.mjs && node tools/reporting/report-public-state-packages.mjs",
    "map:private:deduplicate": "node tools/packages/deduplicate-private-state-packages.mjs --all",
    "map:storage:verify": "node tools/packages/package-storage-policy.mjs",
    "map:public:restore": "node tools/packages/restore-public-package-artifacts.mjs",
    "map:private:verify": "node tools/packages/deduplicate-private-state-packages.mjs --verify && node tools/reporting/report-private-state-packages.mjs",
    "map:public:verify": "node tools/packages/verify-public-state-packages.mjs",
    "map:states:build": "uv run --frozen --group loader python tools/packages/build-state-loader.py",
    "map:states:verify": "uv run --frozen --group loader python tools/packages/verify-state-loader.py",
    "test:state-loader": "uv run --frozen --group loader python -m unittest discover -s python/tests -p test_state_loader.py && node --test tools/test/state-loader-contract.test.mjs",
    "map:packages:backup": "node tools/packages/backup-package-artifacts.mjs",
    "map:laptop": "node tools/laptop/laptop-package-server.mjs",
    "test:laptop": "node --test tools/test/laptop-package-server.test.mjs tools/test/laptop-network.test.mjs tools/test/laptop-pairing.test.mjs tools/test/laptop-update-signing.test.mjs && vitest run packages/map/test/laptop-connection.test.ts packages/map/test/laptop-pairing.test.ts packages/map/test/laptop-packages-hook.test.ts",
    "map:sources:check": "node tools/packages/check-package-source-updates.mjs",
    "docs:generate": "node tools/reporting/report-public-state-packages.mjs",
    "docs:check": "node tools/reporting/report-public-state-packages.mjs --check"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "ajv": "8.18.0",
    "axe-core": "4.13.0",
    "bonjour-service": "1.4.4",
    "jsqr": "1.4.0",
    "maplibre-gl": "6.9.0",
    "playwright": "1.62.1",
    "polygon-clipping": "0.15.7",
    "prettier": "3.9.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
